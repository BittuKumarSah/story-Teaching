# Database - Supabase PostgreSQL (Direct connection)
# Get from Supabase Dashboard > Settings > Database > Connection string
# Format: postgresql+psycopg://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Or with connection pooling (recommended for serverless):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI Provider (gemini, openai, or anthropic)
AI_PROVIDER=gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=your-gemini-api-key

# Supabase (for auth/storage/realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS
CORS_ORIGINS=["https://your-vercel-domain.vercel.app", "http://localhost:3000", "http://localhost:5173"]

# App
APP_NAME=StoryTeacher
APP_VERSION=1.0.0
DEBUG=false